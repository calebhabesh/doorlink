# Smart Doorbell Local Dev Environment Configuration (Arch PC)
# Run with: docker compose --env-file .env.dev up -d

COMPOSE_PROJECT_NAME=smart-doorbell-dev

# Allow docker services (e.g. MQTT broker on 1884) to be reached by physical ESP32 on local network
DOCKER_BIND_IP=0.0.0.0

# Isolated Host Port Mapping (avoiding port conflicts with Fintrak etc.)
POSTGRES_HOST_PORT=5433
MQTT_HOST_PORT=1884
MINIO_API_HOST_PORT=9002
MINIO_CONSOLE_HOST_PORT=9003

# Database Credentials
POSTGRES_DB=smartdoorbell
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# MinIO root credentials
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
