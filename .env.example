# Shared Environment Variables for Smart Doorbell System
# Create a copy of this file named '.env' in the project root:
#   cp .env.example .env
# Make sure to update the values below to match your setup.

# ---------------------------------------------
# Gateway Configuration (Spring Boot)
# ---------------------------------------------

# Secret key used only for authenticating ESP32 hardware requests.
GATEWAY_API_KEY=your_secure_random_api_key_here

# One-time secret used to enroll the first household owner/browser. Generate
# one with: openssl rand -base64 32
# Remove it from .env after initial setup has completed.
HOUSEHOLD_BOOTSTRAP_TOKEN=your_one_time_household_setup_token_here

# Base URL that the ESP32 can reach on the LAN when downloading PTT replies.
INTERCOM_DEVICE_BASE_URL=http://192.168.1.10:8080

# Secure, hard-to-guess ntfy topic name for mobile notifications.
NTFY_TOPIC=your_secret_ntfy_topic_here


# ---------------------------------------------
# Dashboard Configuration (Next.js)
# ---------------------------------------------

# Port / URL where the Spring Boot gateway is running.
# The Next.js middleware uses this to proxy authenticated browser requests.
GATEWAY_URL=http://127.0.0.1:8080
