[Unit]
Description=Smart Doorbell Spring Boot Gateway
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ethioprince
WorkingDirectory=/home/ethioprince/dev/smart-doorbell
# Load environment variables from the shared .env file
EnvironmentFile=/home/ethioprince/dev/smart-doorbell/.env
Environment=SPRING_PROFILES_ACTIVE=prod
# Run the packaged application. Build it with scripts/build-pi-production.sh after pulling changes.
ExecStartPre=/usr/bin/test -f /home/ethioprince/dev/smart-doorbell/gateway/target/gateway-0.0.1-SNAPSHOT.jar
ExecStart=/usr/bin/java -Xms64m -Xmx512m -XX:ActiveProcessorCount=2 -Djava.security.egd=file:/dev/urandom -jar /home/ethioprince/dev/smart-doorbell/gateway/target/gateway-0.0.1-SNAPSHOT.jar
Restart=on-failure
RestartSec=10
SuccessExitStatus=143
Nice=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smart-doorbell-gateway

[Install]
WantedBy=multi-user.target
