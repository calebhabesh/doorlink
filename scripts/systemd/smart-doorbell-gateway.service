[Unit]
Description=Smart Doorbell Spring Boot Gateway
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ethioprince
WorkingDirectory=/home/ethioprince/dev/smart-doorbell/gateway
# Load environment variables from the shared .env file
EnvironmentFile=-/home/ethioprince/dev/smart-doorbell/.env
# Use the Maven wrapper to run the application
ExecStart=/home/ethioprince/dev/smart-doorbell/gateway/mvnw spring-boot:run
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=smart-doorbell-gateway

[Install]
WantedBy=multi-user.target
