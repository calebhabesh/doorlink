[Unit]
Description=Smart Doorbell Spring Boot Gateway
Wants=network-online.target
After=network-online.target smart-doorbell-infra.service
Requires=smart-doorbell-infra.service

[Service]
Type=simple
User=ethioprince
WorkingDirectory=/home/ethioprince/dev/smart-doorbell/.pi-production/gateway/current
# Load environment variables from the shared .env file
EnvironmentFile=-/home/ethioprince/dev/smart-doorbell/.env
Environment=SPRING_PROFILES_ACTIVE=prod
# Run the portable JAR built and deployed from the Arch development machine.
ExecStart=/usr/bin/java -Xms64m -Xmx512m -XX:ActiveProcessorCount=2 -Djava.security.egd=file:/dev/urandom -jar /home/ethioprince/dev/smart-doorbell/.pi-production/gateway/current/gateway.jar
Restart=on-failure
RestartSec=10
SuccessExitStatus=143
Nice=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smart-doorbell-gateway

[Install]
WantedBy=multi-user.target
