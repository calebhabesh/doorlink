[Unit]
Description=Smart Doorbell Docker Compose Infrastructure
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ethioprince
WorkingDirectory=/home/ethioprince/dev/smart-doorbell
EnvironmentFile=-/home/ethioprince/dev/smart-doorbell/.env
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
RemainAfterExit=yes
TimeoutStartSec=180
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smart-doorbell-infra

[Install]
WantedBy=multi-user.target
